{
  "name": "setu",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "app",
    "relay",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "dev:relay": "npm run dev -w relay",
    "node:local": "npm run build -w app && npm run start -w relay",
    "build": "npm run build -w app",
    "build:relay": "npm run build -w relay",
    "test": "npm run test -w shared",
    "test:relay": "npm run test -w relay",
    "lint": "npm run lint -w app",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "typescript": "^5.6.3"
  }
}
