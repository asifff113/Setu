{
  "name": "setu",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "app",
    "relay",
    "shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w app",
    "dev:relay": "npm run dev -w relay",
    "node:local": "npm run build -w app && npm run start -w relay",
    "build": "npm run build -w app",
    "build:native": "npm run build:native -w app",
    "cap:sync": "npm run cap:sync -w app",
    "build:relay": "npm run build -w relay",
    "test": "npm run test -w shared && npm run test -w app && npm run test -w relay",
    "test:relay": "npm run test -w relay",
    "lint": "npm run lint -w app && npm run lint -w relay && npm run lint -w shared",
    "typecheck:relay": "npm run build -w relay",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    }
  }
}
